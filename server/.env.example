# SME Rhizome Builder — Hono server environment
# Copy to .env and fill in values.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Default local DB: postgres://localhost/rhizome-builder
# Run schema first: psql rhizome-builder < schema.sql
DATABASE_URL=postgres://localhost/rhizome-builder

# JWT signing secret — change before deploying
JWT_SECRET_KEY=dev-secret-change-in-production

# ── Optional ──────────────────────────────────────────────────────────────────

# AI backend for the concierge (default: local Qwen on 5052)
# Options: local | anthropic | openai | ollama
CONCIERGE_ENDPOINT=local

# Anthropic API key (only needed if CONCIERGE_ENDPOINT=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Canvas OAuth (leave unset to enable demo mode)
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_BASE_URL=https://unity.instructure.com
# CANVAS_REDIRECT_URI=http://localhost:5051/api/auth/callback

# Port (default: 5051)
# HONO_PORT=5051
