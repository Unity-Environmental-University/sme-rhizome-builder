# Copy to .env and fill in values.
# .env is gitignored — never commit real credentials.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Canvas OAuth — register a Developer Key in Canvas to get these
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_BASE_URL=https://unity.instructure.com
CANVAS_OAUTH_REDIRECT_URI=http://localhost:5050/api/auth/callback

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Database (defaults to SQLite; swap for Postgres in production)
# DATABASE_URL=postgresql://user:pass@localhost/rhizome

# Frontend URL (for OAuth redirect after login)
# Update if Vite lands on a different port (e.g. 5174 when 5173 is in use)
FRONTEND_URL=http://localhost:5173
