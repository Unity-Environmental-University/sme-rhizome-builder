{
  "name": "sme-rhizome-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"vite\" \"python backend/app.py\" \"svelte-check --tsconfig ./tsconfig.json --watch 2>&1 | tee .svelte-check.log\"",
